<nav class="sidebar" id="sidebar">
  <a class="sidebar-item sidebar-home active" id="home-item"
     href="{{ '/' | url }}"
     onclick="showHome(); return false;">
    🏠 Home
  </a>
  <a class="sidebar-item" id="releases-item"
     href="?releases=all"
     onclick="selectReleases('all'); return false;">
    🏷 Recent Releases
  </a>
  <hr class="sidebar-hr">
  <div class="sidebar-label">Categories</div>
  {%- for cat in categories %}
  <a class="sidebar-item"
     href="?cat={{ cat.slug }}"
     data-category="{{ cat.slug }}"
     onclick="selectCategory('{{ cat.slug }}', this); return false;">
    {{ cat.sidebarLabel if cat.sidebarLabel else cat.label }}
  </a>
  {%- endfor %}
  <hr class="sidebar-hr">
  <div class="sidebar-label">Community</div>
  <a class="sidebar-item sidebar-ext" href="https://discord.gg/tenstorrent" target="_blank" rel="noopener noreferrer">💬 Discord</a>
  <a class="sidebar-item sidebar-ext" href="https://console.tenstorrent.com" target="_blank" rel="noopener noreferrer">🚀 TT Console</a>
  <a class="sidebar-item sidebar-ext" href="https://docs.tenstorrent.com" target="_blank" rel="noopener noreferrer">📖 Docs</a>
  <a class="sidebar-item sidebar-ext" href="https://tenstorrent.com/en/developers" target="_blank" rel="noopener noreferrer">🛠 Developer Hub</a>
  <a class="sidebar-item sidebar-ext" href="https://www.youtube.com/@tenstorrentinc" target="_blank" rel="noopener noreferrer">▶ YouTube</a>
  <a class="sidebar-item sidebar-ext" href="https://github.com/tenstorrent" target="_blank" rel="noopener noreferrer">⌥ GitHub</a>
  <hr class="sidebar-hr">
  <a class="sidebar-item" href="{{ '/planet/' | url }}">🪐 Planet Tenstorrent</a>
  <div class="sidebar-submit-wrap">
    <a class="sidebar-submit" href="https://github.com/tenstorrent/tt-awesome/issues/new?template=submit-entry.yml" target="_blank" rel="noopener noreferrer">+ Submit entry</a>
  </div>
</nav>
