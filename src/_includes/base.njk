    posthog.init("phc_9LMRmHrCFvQNvDkPDjYBP5dZ6WchZ5bcM6T4Qj6tb0U", {
      api_host: "https://us.i.posthog.com",
      defaults: "2025-05-24",
      person_profiles: "identified_only"
    });
  </script>
</head>
<body>
  {{ content | safe }}
  <script>{% inlineFile "src/assets/main.js" %}</script>
</body>
</html>
