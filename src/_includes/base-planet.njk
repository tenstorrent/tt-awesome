<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Planet Tenstorrent — tt-awesome</title>
  <meta name="description" content="Papers, articles, lessons, talks, videos, and releases from the Tenstorrent ecosystem — curated by the community.">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="tt-awesome">
  <meta property="og:title" content="Planet Tenstorrent">
  <meta property="og:description" content="Papers, articles, lessons, talks, videos, and releases from the Tenstorrent ecosystem.">
  <meta property="og:url" content="https://tenstorrent.github.io/tt-awesome/planet/">

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@tenstorrent">

  <!-- Inline CSS: global variables + scrollbar styles, then planet layout -->
  <style>{% inlineFile "src/assets/style.css" %}</style>
  <style>{% inlineFile "src/assets/planet.css" %}</style>

  <!-- PostHog analytics (same key as docs.tenstorrent.com sites) -->
  <script>
    (function (t, e) {
      var o, n, p, r;
      if (!e.__SV) {
        window.posthog = e; e._i = []; e.init = function (i, s, a) {
          function g(t, e) { var o = e.split("."); if (o.length === 2) { t = t[o[0]]; e = o[1]; } t[e] = function () { t.push([e].concat(Array.prototype.slice.call(arguments, 0))); }; }
          p = t.createElement("script"); p.type = "text/javascript"; p.crossOrigin = "anonymous"; p.async = true;
          p.src = s.api_host.replace(".i.posthog.com", "-assets.i.posthog.com") + "/static/array.js";
          r = t.getElementsByTagName("script")[0]; r.parentNode.insertBefore(p, r);
          var u = e; if (a !== undefined) { u = e[a] = []; } else { a = "posthog"; }
          u.people = u.people || []; u.toString = function (t) { var e = "posthog"; if (a !== "posthog") { e += "." + a; } if (!t) { e += " (stub)"; } return e; };
          u.people.toString = function () { return u.toString(1) + ".people (stub)"; };
          var methods = ("init capture identify setPersonProperties reset get_distinct_id getGroups get_session_id alias set_config startSessionRecording stopSessionRecording opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug").split(" ");
          for (n = 0; n < methods.length; n++) { g(u, methods[n]); } e._i.push([i, s, a]);
        }; e.__SV = 1;
      }
    })(document, window.posthog || []);
    posthog.init("phc_9LMRmHrCFvQNvDkPDjYBP5dZ6WchZ5bcM6T4Qj6tb0U", {
      api_host: "https://us.i.posthog.com",
      defaults: "2025-05-24",
      person_profiles: "identified_only"
    });
  </script>
</head>
<body>
  <div class="planet-page">
    {{ content | safe }}
  </div>

  <script>
    // Planet page interactivity — filter by type, collapse/expand sidebar
    (function() {
      var feed     = document.getElementById('planet-feed');
      var sidebar  = document.getElementById('planet-sidebar');
      var body     = document.getElementById('planet-body');
      var filterBtns = document.querySelectorAll('[data-planet-filter]');
      var chipBtns   = document.querySelectorAll('[data-planet-chip]');

      // Apply a type filter to the feed.  Pass "all" to show everything.
      function setFilter(type) {
        if (type === 'all') {
          feed.removeAttribute('data-active-type');
        } else {
          feed.setAttribute('data-active-type', type);
        }

        // Sync sidebar button active states + aria-pressed
        filterBtns.forEach(function(btn) {
          var isActive = btn.dataset.planetFilter === type;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        // Sync chip active states + aria-pressed
        chipBtns.forEach(function(btn) {
          var isActive = btn.dataset.planetChip === type;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        // Hide month headers that have no visible items under them
        var activeType = feed.getAttribute('data-active-type');
        document.querySelectorAll('.planet-month').forEach(function(header) {
          var el = header.nextElementSibling;
          var hasVisible = false;
          while (el && !el.classList.contains('planet-month')) {
            if (el.classList.contains('planet-item') &&
                (!activeType || el.dataset.type === activeType)) {
              hasVisible = true;
              break;
            }
            el = el.nextElementSibling;
          }
          header.style.display = hasVisible ? '' : 'none';
        });
      }

      // Wire filter buttons (sidebar)
      filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { setFilter(btn.dataset.planetFilter); });
      });

      // Wire chip buttons (mobile bar)
      chipBtns.forEach(function(btn) {
        btn.addEventListener('click', function() { setFilter(btn.dataset.planetChip); });
      });

      // Sidebar collapse
      var collapseBtn = document.getElementById('planet-collapse-btn');
      if (collapseBtn) {
        collapseBtn.addEventListener('click', function() {
          sidebar.classList.add('collapsed');
          body.classList.add('sidebar-collapsed');
        });
      }

      // Sidebar expand
      var expandBtn = document.getElementById('planet-expand-btn');
      if (expandBtn) {
        expandBtn.addEventListener('click', function() {
          sidebar.classList.remove('collapsed');
          body.classList.remove('sidebar-collapsed');
        });
      }
    })();
  </script>
</body>
</html>
