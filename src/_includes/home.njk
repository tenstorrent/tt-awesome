<div class="home-view" id="home-view">
  <div class="home-hero">
    <div class="home-eyebrow">Community · Open Source · Tenstorrent Ecosystem</div>
    <h1 class="home-title">A hidden dimension of Tenstorrent awesomeness</h1>
    <p class="home-sub">A curated directory of projects, tools, models, and research for Tenstorrent hardware — contributed by the community and our team. Browse by category or search across all entries.</p>
    <div class="home-stats">
      <div class="home-stat">
        <span class="home-stat-n">{{ entries | length }}</span>
        <span class="home-stat-l">Projects</span>
      </div>
      <div class="home-stat">
        <span class="home-stat-n">{{ categories | length }}</span>
        <span class="home-stat-l">Categories</span>
      </div>
      <div class="home-stat">
        <span class="home-stat-n">Open</span>
        <span class="home-stat-l">Source</span>
      </div>
    </div>
  </div>

  <div class="home-section-label">Browse by category</div>
  {%- set featuredMap = entries | diversifiedFeatured(categories) %}
  <div class="cat-grid">
    {%- for cat in categories %}
    {%- set topEntries = featuredMap[cat.slug] %}
    {%- set count = entries | countForCategory(cat.slug) %}
    <div class="cat-card" onclick="selectCategoryBySlug('{{ cat.slug }}')">
      <div class="cat-card-top">
        <div class="cat-card-name">{{ cat.label }}</div>
        <div class="cat-card-desc">{{ cat.description }}</div>
      </div>
      {%- if topEntries and topEntries.length %}
      <div class="cat-card-features">
        {%- for topEntry in topEntries %}
        <div class="cat-card-feature">
          <div class="cat-card-feature-name">{{ topEntry.name }}
            <span class="badge badge--{{ topEntry.affiliation }}">{{ topEntry.affiliation }}</span>
          </div>
          <div class="cat-card-feature-desc">{{ topEntry.description | truncate(100) }}</div>
        </div>
        {%- endfor %}
      </div>
      {%- endif %}
      <div class="cat-card-footer">
        <span class="cat-card-count">{{ count }} {{ "entry" if count == 1 else "entries" }}</span>
        <span class="cat-card-browse">Browse →</span>
      </div>
    </div>
    {%- endfor %}
  </div>

  <div class="home-section-label">Fresh from Planet Tenstorrent</div>
  <div class="home-planet">
    <p class="home-planet-blurb">
      <strong>Planet Tenstorrent</strong> is the ecosystem's live feed — new releases,
      articles, papers, talks, and community posts from across the Tenstorrent world,
      gathered in one place and updated daily. The latest five:
    </p>
    {%- set planetPreview = entries | planetItems(recentReleases, planetFeeds) %}
    <div class="home-planet-items">
      {%- for item in planetPreview.slice(0, 5) %}
      <a class="home-planet-item" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
        <span class="home-planet-type home-planet-type--{{ item.type }}">
          {%- if item.type == "paper" %}📄 paper
          {%- elif item.type == "article" %}📝 article
          {%- elif item.type == "lesson" %}📖 lesson
          {%- elif item.type == "video" %}🎥 video
          {%- elif item.type == "talk" %}🎤 talk
          {%- elif item.type == "demo" %}🚀 demo
          {%- else %}🏷 release
          {%- endif %}
        </span>
        <span class="home-planet-title">{{ item.title }}</span>
        <span class="home-planet-date">{{ item.date | prettyDate }}</span>
      </a>
      {%- endfor %}
    </div>
    <a class="home-planet-more" href="{{ '/planet/' | url }}">🪐 Explore Planet Tenstorrent →</a>
  </div>
</div>
