---
layout: base-models.njk
pagination:
  data: modelsSite.models
  size: 1
  alias: m
permalink: "models/{{ m.id }}/index.html"
eleventyExcludeFromCollections: true
eleventyComputed:
  activeUrl: "{{ m.url }}"
  openGroup: "kinds"
  canonicalPath: "models/{{ m.id }}/"
  pageTitle: "{{ m.name }} — Models — tt-awesome"
  pageDescription: "{{ m.name }} ({{ m.kind }}). {{ m.summary }}"
---
{%- from "models-macros.njk" import command -%}
{%- set kindUrl = modelsSite.urls.kind[m.kind] -%}
{#- tt launch matches --model against the id the server reports. A tt-inference-server model is in tt's catalog under its name. A bundle reports its weights repo (tt-model's /v1/models), so a bundle-only model uses that. -#}
{%- set launchModel = m.serve if m.inSpec else (m.weights or m.upstream or m.serve) -%}
{%- set familyUrl = modelsSite.urls.family[m.family] -%}
<nav class="m-crumb" aria-label="Breadcrumb"><a href="{{ '/' | url }}">tt-awesome</a><span>/</span><a href="{{ '/models/' | url }}">Models</a><span>/</span>{% if kindUrl %}<a href="{{ kindUrl | url }}">{{ m.kind }}</a>{% else %}<span>{{ m.kind }}</span>{% endif %}<span>/</span><span aria-current="page">{{ m.name }}</span></nav>

<div class="mp">
  <div class="mp-main">
    <div class="kind">
      {%- if kindUrl %}<a href="{{ kindUrl | url }}">{{ m.kind }}</a>{% else %}<span>{{ m.kind }}</span>{% endif %}{% if m.kindInferred %}<span class="m-pill">kind inferred</span>{% endif %}
      <span class="m-pill{{ ' tt' if m.inSpec }}" title="{{ 'Listed in the tt-inference-server release spec' if m.inSpec else 'Published as a tt-model bundle, not in the tt-inference-server release spec. Not reviewed by Tenstorrent. Serve at your own risk.' }}">{{ "Official" if m.inSpec else "Community model" }}</span>
      {%- if familyUrl %}<a class="m-pill" href="{{ familyUrl | url }}">{{ m.family }} family</a>{% endif %}
    </div>
    <h1 class="m-title">{{ m.name }}</h1>
    {%- if m.upstream %}<div class="upstream">{% set up = m.upstream | hfUrl %}{% if up %}<a href="{{ up }}" target="_blank" rel="noopener noreferrer">{{ m.upstream }}</a>{% else %}{{ m.upstream }}{% endif %}</div>{% endif %}
    <p class="m-blurb">{{ m.summary }}</p>
    {%- if not m.inSpec %}<p class="m-warn"><strong>Community model.</strong> It is published as a tt-model bundle and is not in tt-inference-server's release spec. Tenstorrent has not reviewed the model or its bundle{{ "s" if m.bundles.length > 1 }}. Serve at your own risk.</p>{% endif %}

    {%- if m.rows.length %}
    <h2 class="m-h">In tt-inference-server</h2>
    <div class="m-scroll"><table class="m-table">
      <tr><th>Hardware</th><th>Engine and implementation</th><th>Status</th><th>Context</th><th>Users</th><th>Build</th><th>Support page</th></tr>
      {%- for r in m.rows %}
      <tr>
        <td>{% if modelsSite.urls.hardware[r.hardware] %}<a href="{{ modelsSite.urls.hardware[r.hardware] | url }}">{{ r.hardware }}</a>{% else %}{{ r.hardware }}{% endif %}<div class="m-sub"><code>{{ r.deviceKey }}</code></div></td>
        <td>{{ r.engine }}{% if r.impl %}<div class="m-sub">{{ r.impl }}</div>{% endif %}</td>
        <td>{{ r.status }}</td>
        <td class="num">{{ r.context or "-" }}</td>
        <td class="num">{{ r.users if r.users != null else "-" }}</td>
        <td class="m-build">{%- set cl = r.codeLink | safeHttpsUrl %}{% if cl %}<div class="m-sub">Code: <a href="{{ cl }}" target="_blank" rel="noopener noreferrer">{{ cl }}</a></div>{% elif r.codeLink %}<div class="m-sub">Code: {{ r.codeLink }}</div>{% endif %}
          {%- if r.ttMetal %}<div class="m-sub">tt-metal <code>{{ r.ttMetal }}</code></div>{% endif %}
          {%- if r.vllm %}<div class="m-sub">vLLM <code>{{ r.vllm }}</code></div>{% endif %}
          {%- if r.image %}<div class="m-sub">Image <code class="wrap">{{ r.image }}</code></div>{% endif %}
          {%- if not (r.codeLink or r.ttMetal or r.vllm or r.image) %}-{% endif %}</td>
        <td>{% set du = r.docUrl | safeHttpsUrl %}{% if du %}<a href="{{ du }}" target="_blank" rel="noopener noreferrer">Open</a>{% else %}-{% endif %}</td>
      </tr>
      {%- endfor %}
    </table></div>
    <p class="m-note">Status, context and users are copied from tt-inference-server's release spec (commit <code>{{ modelsSite.spec.commit }}</code>, release {{ modelsSite.spec.release }}). Context is the longest prompt plus reply the entry allows. Users is its highest concurrency. Each row carries its own code link, tt-metal and vLLM commits and image, because they differ between hardware. Nothing on this page is measured.</p>
    {%- endif %}

    <h2 class="m-h">tt-model bundles</h2>
    {%- if m.bundles.length %}
    <div class="m-scroll"><table class="m-table">
      <tr><th>Bundle</th><th>Hardware</th><th>Served with</th><th>Context</th><th>Pushed</th><th></th></tr>
      {%- for b in m.bundles %}
      <tr>
        <td>{% set bu = b.repo | hfUrl %}{% if bu %}<a href="{{ bu }}" target="_blank" rel="noopener noreferrer">{{ b.repo }}</a>{% else %}{{ b.repo }}{% endif %}{% if b.schema == "6" %} <span class="m-fit" title="tt-model's v6 thin format is beta and unsupported">v6, beta</span>{% endif %}</td>
        <td>{%- if b.hardware and b.hardware.length %}{% for h in b.hardware %}{{ ", " if not loop.first }}{% if modelsSite.urls.hardware[h.product] %}<a href="{{ modelsSite.urls.hardware[h.product] | url }}">{{ h.product }}</a>{% else %}{{ h.product }}{% endif %}{% endfor %}{% else %}Not stated{% endif %}</td>
        <td>{{ b.bundleKind or "Not stated" }}</td>
        <td class="num">{{ b.context or "-" }}</td>
        <td class="num">{{ b.updated }}</td>
        <td><button type="button" class="m-copy sm" data-copy="tt serve {{ b.repo }}" aria-label="Copy: tt serve {{ b.repo }}">Copy serve</button></td>
      </tr>
      {%- endfor %}
    </table></div>
    <p class="m-note">From <code>tt-model search --catalog</code> and each bundle's manifest (<code>tt-model info</code>). A bundle lists every hardware profile its manifest defines. Each bundle is published by its owner, and Tenstorrent has not reviewed it. Serve at your own risk.</p>
    {%- else %}
    <p class="m-none">No tt-model bundle has been published for this model.</p>
    {%- endif %}

    <h2 class="m-h">Details</h2>
    <table class="m-table m-dl">
      <tr><td>Kind</td><td>{{ m.kind }} <span class="m-sub">({% if m.kindInferred %}{{ m.kindFrom }}{% else %}from {{ m.kindFrom }}{% endif %})</span></td></tr>
      {%- if m.params %}<tr><td>Parameters</td><td>{{ m.params }}</td></tr>{% endif %}
      <tr><td>Family</td><td>{{ m.family }} <span class="m-sub">(from the start of the name)</span></td></tr>
      {%- if m.impls.length %}<tr><td>Implementation</td><td>{{ m.impls | join(", ") }}</td></tr>{% endif %}
      {%- if m.minDiskGb %}<tr><td>Disk needed</td><td>{{ m.minDiskGb }} GB</td></tr>{% endif %}
      {%- if m.minRamGb %}<tr><td>RAM needed</td><td>{{ m.minRamGb }} GB</td></tr>{% endif %}
      {%- if m.toolParser %}<tr><td>Tool-call parser</td><td><code>{{ m.toolParser }}</code></td></tr>{% endif %}
      {%- if m.reasoningParser %}<tr><td>Reasoning parser</td><td><code>{{ m.reasoningParser }}</code></td></tr>{% endif %}
      {%- if m.licenses.length %}<tr><td>License{{ "s" if m.licenses.length > 1 }} (bundle cards)</td><td>{{ m.licenses | join(", ") }}</td></tr>{% endif %}
      <tr><td>Listed by</td><td>{{ m.source }}</td></tr>
    </table>
  </div>

  <aside class="mp-side" aria-label="Install and run">
    <div class="kind">Install and run</div>
    {#- A model whose upstream is a bare label (the forge CNNs) has no Hub weights: tt model pull refuses it, and tt serve fetches the container image. -#}
    {%- if m.inSpec and "/" not in m.upstream %}<p class="m-note">Nothing to download first. Its weights ship inside the container image, and <code>tt serve</code> fetches the image.</p>
    {%- else %}{{ command("Download the weights" + ("" if m.inSpec else " and the bundle"), "tt model pull " + m.serve) }}{% endif %}
    {%- if not m.inSpec %}<p class="m-warn sm">Not reviewed by Tenstorrent. Serve at your own risk.</p>{% endif %}
    {{ command("Serve it on this machine", "tt serve " + m.serve) }}
    {%- if not m.inSpec %}<p class="m-note">A tt-model bundle, so <code>tt serve</code> runs it through tt-model. If a bundle needs hardware you do not have, tt says so.</p>{% endif %}
    {%- if m.bundles.length and m.inSpec %}<p class="m-note">To serve one of its tt-model bundles instead, use the Copy serve button beside it.</p>{% endif %}

    {%- if m.studio %}<p class="m-studio"><span>tt-studio</span> opens this as the <strong>{{ m.studio }}</strong> page. It picks the page from the model type.</p>{% endif %}

    <div class="kind m-kind-gap">Connect a client with tt launch</div>
    {%- if m.clients.length %}
    <p class="m-note">Serve the model first, then run one of these. Only clients that work with this model are listed.</p>
    {%- for c in m.clients %}
    <div class="m-cmd compact">
      <div class="lbl">{{ c.type }}. {{ c.note }}</div>
      <code>tt launch {{ c.id }} --model {{ launchModel }}</code>
      <button type="button" class="m-copy" data-copy="tt launch {{ c.id }} --model {{ launchModel }}" aria-label="Copy: tt launch {{ c.id }} --model {{ launchModel }}">Copy</button>
    </div>
    {%- endfor %}
    <p class="m-note">Terminal clients need a tool-call parser. Open WebUI and AnythingLLM take any chat model. The rule is tt-cli's (<code>tt launch</code>).{% if not m.inSpec %} This model is not in tt's catalog, so tt warns instead of checking. The listing comes from the bundle's manifest, which says it is served with vLLM{% if m.toolParser %} and names the <code>{{ m.toolParser }}</code> parser{% endif %}.{% endif %}</p>
    {%- else %}
    <p class="m-none">None. tt launch connects chat models served with vLLM{% if m.inSpec %}, and tt-inference-server lists no vLLM entry for this model{% else %}, and no bundle of this model is served with vLLM{% endif %}.</p>
    {%- endif %}
  </aside>
</div>
