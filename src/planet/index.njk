---
layout: base-planet.njk
permalink: /planet/
eleventyExcludeFromCollections: true
---
{#-
  Planet Tenstorrent — /planet/
  Data sources: entries (_data/entries.js), recentReleases (_data/recentReleases.js),
                planetFeeds (_data/planetFeeds.js → planet_feeds.json)
  Key filters: planetItems(entries, recentReleases, planetFeeds), monthKey, monthLabel, prettyDate
-#}
{%- set items = entries | planetItems(recentReleases, planetFeeds) %}

{%- set paperCount   = items | planetCount("paper")   %}
{%- set articleCount = items | planetCount("article") %}
{%- set lessonCount  = items | planetCount("lesson")  %}
{%- set videoCount   = items | planetCount("video")   %}
{%- set talkCount    = items | planetCount("talk")    %}
{%- set demoCount    = items | planetCount("demo")    %}
{%- set releaseCount = items | planetCount("release") %}

<!-- Topbar -->
<header class="planet-topbar">
  <a class="planet-back" href="{{ '/' | url }}">← tt-awesome</a>
  <span class="planet-topbar-divider">/</span>
  <span class="planet-title">🪐 Planet Tenstorrent</span>
  <div class="planet-feed-links">
    <a class="planet-feed-link" href="{{ '/feeds/releases.xml' | url }}" target="_blank" rel="noopener noreferrer">📡 Atom</a>
    <a class="planet-feed-link" href="{{ '/feeds/feed.json' | url }}" target="_blank" rel="noopener noreferrer">📡 JSON</a>
  </div>
</header>

<!-- Mobile chip filter bar — shown only on narrow viewports via CSS -->
<div class="planet-chips-bar">
  <button class="planet-chip active" data-planet-chip="all">All ({{ items | length }})</button>
  {%- if paperCount > 0 %}
  <button class="planet-chip" data-planet-chip="paper">📄 Papers ({{ paperCount }})</button>
  {%- endif %}
  {%- if articleCount > 0 %}
  <button class="planet-chip" data-planet-chip="article">📝 Articles ({{ articleCount }})</button>
  {%- endif %}
  {%- if lessonCount > 0 %}
  <button class="planet-chip" data-planet-chip="lesson">📖 Lessons ({{ lessonCount }})</button>
  {%- endif %}
  {%- if videoCount > 0 %}
  <button class="planet-chip" data-planet-chip="video">🎥 Videos ({{ videoCount }})</button>
  {%- endif %}
  {%- if talkCount > 0 %}
  <button class="planet-chip" data-planet-chip="talk">🎤 Talks ({{ talkCount }})</button>
  {%- endif %}
  {%- if demoCount > 0 %}
  <button class="planet-chip" data-planet-chip="demo">🚀 Demos ({{ demoCount }})</button>
  {%- endif %}
  {%- if releaseCount > 0 %}
  <button class="planet-chip" data-planet-chip="release">🏷 Releases ({{ releaseCount }})</button>
  {%- endif %}
</div>

<!-- Two-column body: filter sidebar + scrollable content -->
<div class="planet-body" id="planet-body">

  <!-- Filter sidebar (hidden on narrow viewports, collapsible on wide) -->
  <nav class="planet-sidebar" id="planet-sidebar" aria-label="Filter by type">
    <div class="planet-sidebar-label">Filter</div>

    <button class="planet-filter-btn active" data-planet-filter="all">
      All <span class="planet-filter-count">{{ items | length }}</span>
    </button>
    {%- if paperCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="paper">
      📄 Papers <span class="planet-filter-count">{{ paperCount }}</span>
    </button>
    {%- endif %}
    {%- if articleCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="article">
      📝 Articles <span class="planet-filter-count">{{ articleCount }}</span>
    </button>
    {%- endif %}
    {%- if lessonCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="lesson">
      📖 Lessons <span class="planet-filter-count">{{ lessonCount }}</span>
    </button>
    {%- endif %}
    {%- if videoCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="video">
      🎥 Videos <span class="planet-filter-count">{{ videoCount }}</span>
    </button>
    {%- endif %}
    {%- if talkCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="talk">
      🎤 Talks <span class="planet-filter-count">{{ talkCount }}</span>
    </button>
    {%- endif %}
    {%- if demoCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="demo">
      🚀 Demos <span class="planet-filter-count">{{ demoCount }}</span>
    </button>
    {%- endif %}
    {%- if releaseCount > 0 %}
    <button class="planet-filter-btn" data-planet-filter="release">
      🏷 Releases <span class="planet-filter-count">{{ releaseCount }}</span>
    </button>
    {%- endif %}

    <hr class="planet-sidebar-hr">

    <div class="planet-subscribe-label">Subscribe</div>
    <a class="planet-subscribe-link" href="{{ '/feeds/releases.xml' | url }}" target="_blank" rel="noopener noreferrer">📡 Releases (Atom)</a>
    <a class="planet-subscribe-link" href="{{ '/feeds/articles.xml' | url }}" target="_blank" rel="noopener noreferrer">📡 Articles (Atom)</a>
    <a class="planet-subscribe-link" href="{{ '/feeds/feed.json' | url }}" target="_blank" rel="noopener noreferrer">📡 JSON Feed</a>

    <div class="planet-sidebar-collapse">
      <button class="planet-collapse-btn" id="planet-collapse-btn">← Collapse</button>
    </div>
  </nav>

  <!-- Main content: items grouped by month -->
  <main class="planet-content">
    <div class="planet-content-inner">

      <!-- Expand button — only visible when sidebar is collapsed -->
      <button class="planet-expand-btn" id="planet-expand-btn">☰ Filters</button>

      <!--
        The feed container receives data-active-type="<type>" when a filter is
        active.  The planet.css hides .planet-item elements whose [data-type]
        doesn't match, so no JS per-item toggling is needed.
      -->
      <div class="planet-feed" id="planet-feed">
        {%- for item in items %}
          {%- set thisMonth = item.date | monthKey %}
          {%- set prevMonth = items[loop.index0 - 1].date | monthKey if loop.index0 > 0 else "" %}
          {%- if thisMonth != prevMonth %}
        <div class="planet-month">{{ item.date | monthLabel }}</div>
          {%- endif %}
        {%- include "planet-item.njk" %}
        {%- endfor %}

        {%- if not items.length %}
        <div class="planet-empty">No items yet — check back soon.</div>
        {%- endif %}
      </div>{# /planet-feed #}

    </div>{# /planet-content-inner #}
  </main>

</div>{# /planet-body #}
